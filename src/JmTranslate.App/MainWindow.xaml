<Window x:Class="JmTranslate.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JM-Translate" Width="1020" Height="720" MinWidth="520" MinHeight="230"
        Background="#FF16181D" Foreground="#FFE8E8E8" Topmost="True"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#FFA0A4AB" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Header">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style TargetType="Button" x:Key="Bar">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="96" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superior: ¿ya puedo hablar? + controles de emergencia -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TalkIndicator" Grid.Column="0" CornerRadius="4" Background="#FF2C3038" Height="46">
                <Grid>
                    <ProgressBar x:Name="TalkBar" Minimum="0" Maximum="1" Value="0" Background="Transparent"
                                 BorderThickness="0" Foreground="#FFE0554C" />
                    <TextBlock x:Name="TalkIndicatorText" Text="Pulsa «Hablar» para empezar" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="MuteButton" Style="{StaticResource Bar}" Content="Silenciar" Click="MuteButton_Click"
                        ToolTip="Corta al instante lo que se envía. Atajo: Ctrl+Alt+Numpad0" />
                <Button x:Name="BankButton" Style="{StaticResource Bar}" Content="Frases" Click="BankButton_Click"
                        ToolTip="Banco de frases preparadas. Atajos: Ctrl+Alt+Numpad1…9" />
                <Button x:Name="CompactButton" Style="{StaticResource Bar}" Content="Compacto" Click="CompactButton_Click"
                        ToolTip="Ventana pequeña con solo el indicador y los subtítulos. Atajo: Ctrl+Alt+Numpad." />
                <Button x:Name="StartAllButton" Style="{StaticResource Bar}" Content="Iniciar todo" Click="StartAllButton_Click" />
            </StackPanel>
        </Grid>

            <!-- Sugerencia de respuesta del banco para la pregunta que acaban de hacer -->
            <Border x:Name="SuggestBorder" Visibility="Collapsed" Margin="0,8,0,0" Padding="12,8" CornerRadius="4" Background="#FF1F3A5F">
                <TextBlock x:Name="SuggestText" FontSize="15" TextWrapping="Wrap" Foreground="White" />
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" x:Name="ConfigPanel">
            <!-- ELLOS -> YO -->
            <Border BorderBrush="#FF2C3038" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Ellos → yo  (ellos hablan inglés, yo leo/oigo español)" Style="{StaticResource Header}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Audio de la reunión (dispositivo que suena)" Style="{StaticResource Label}" />
                            <ComboBox x:Name="CaptureCombo" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Voz en español sale por" Style="{StaticResource Label}" />
                            <ComboBox x:Name="SpeakCombo" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ListenButton" Content="Escuchar" Width="100" Padding="0,5" Click="ListenButton_Click" />
                        <CheckBox x:Name="VoiceCheck" Content="Voz en español" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFE8E8E8" />
                        <CheckBox x:Name="OriginalCheck" Content="Mostrar texto original" IsChecked="True" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#FFE8E8E8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Respuestas del banco:" Foreground="#FFA0A4AB" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ModeCombo" Width="230"
                                  ToolTip="Sugerir: al oír una pregunta que encaja con el banco te muestra la respuesta; la envías con Ctrl+Alt+Enter. Automático: la envía sola tras una cuenta atrás que puedes cancelar con Ctrl+Alt+*." />
                        <CheckBox x:Name="VoiceCmdCheck" Content="Comandos de voz («banco, saludo»)" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFE8E8E8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- YO -> ELLOS -->
            <Border BorderBrush="#FF2C3038" BorderThickness="1" Padding="10" Margin="0,0,0,8" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Yo → ellos  (yo hablo español, ellos me oyen en inglés)" Style="{StaticResource Header}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mi micrófono" Style="{StaticResource Label}" />
                            <ComboBox x:Name="MicCombo" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Enviar inglés a (micrófono virtual)" Style="{StaticResource Label}" />
                            <ComboBox x:Name="SendCombo" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Escuchar lo que envío por (opcional)" Style="{StaticResource Label}" />
                            <ComboBox x:Name="MonitorCombo" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="TalkButton" Content="Hablar" Width="100" Padding="0,5" Click="TalkButton_Click" />
                        <CheckBox x:Name="SendVoiceCheck" Content="Enviar voz (si no, solo texto)" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFE8E8E8" />
                        <TextBlock Text="Voz:" Foreground="#FFA0A4AB" Margin="14,0,6,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="VoiceCombo" Width="190" />
                        <CheckBox x:Name="CloneCheck" Content="Mi voz (más lento)" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFE8E8E8" />
                        <TextBlock x:Name="CloneHint" Foreground="#FF8A8F98" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="PttCheck" Content="Pulsar para hablar:" VerticalAlignment="Center" Foreground="#FFE8E8E8"
                                  ToolTip="Solo se te escucha mientras mantienes la tecla; al soltarla, tu frase se envía de inmediato." />
                        <ComboBox x:Name="PttKeyCombo" Width="130" Margin="8,0,0,0" />
                        <TextBlock Text="En la app de la reunión elige «CABLE Output» como micrófono." Foreground="#FF8A8F98" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="#FF0E1014">
            <ItemsControl x:Name="Lines" Margin="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding Translation}" FontSize="22" TextWrapping="Wrap" Foreground="{Binding Color}" />
                            <TextBlock Text="{Binding Original}" FontSize="13" TextWrapping="Wrap" Foreground="#FF8A8F98" Margin="0,2,0,0"
                                       Visibility="{Binding OriginalVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="StatusText" Margin="0,8,0,0" Foreground="#FFA0A4AB" Text="Listo." TextWrapping="Wrap" />
    </Grid>
</Window>
