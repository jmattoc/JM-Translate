<Window x:Class="JmTranslate.App.PhraseBankWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Banco de frases" Width="960" Height="620" MinWidth="760" MinHeight="480"
        Background="#FF16181D" Foreground="#FFE8E8E8" Topmost="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0E1014" />
            <Setter Property="Foreground" Value="#FFE8E8E8" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="BorderBrush" Value="#FF2C3038" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#FFA0A4AB" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="NewButton" Content="Nueva" Click="NewButton_Click" />
                <Button x:Name="DeleteButton" Content="Eliminar" Click="DeleteButton_Click" />
            </StackPanel>
            <ListBox x:Name="List" Background="#FF0E1014" Foreground="#FFE8E8E8" BorderBrush="#FF2C3038"
                     SelectionChanged="List_SelectionChanged" FontSize="14" />
        </DockPanel>

        <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Nombre corto" Style="{StaticResource Label}" Margin="0,0,0,3" />
                <TextBox x:Name="LabelBox" AcceptsReturn="False" TextWrapping="NoWrap" />

                <TextBlock Text="Lo que quiero decir (español)" Style="{StaticResource Label}" />
                <TextBox x:Name="EsBox" Height="110" />

                <TextBlock Text="Lo que se dirá (inglés) — revísalo y corrígelo antes de preparar" Style="{StaticResource Label}" />
                <TextBox x:Name="EnBox" Height="130" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="TranslateButton" Content="Traducir español → inglés" Click="TranslateButton_Click" />
                    <Button x:Name="PrepareButton" Content="Preparar audio" Click="PrepareButton_Click" />
                    <Button x:Name="PlayButton" Content="Enviar ahora" Click="PlayButton_Click" />
                    <Button x:Name="CopyButton" Content="Copiar inglés" Click="CopyButton_Click"
                            ToolTip="Copia el texto en inglés para pegarlo en el chat de la reunión (plan B si falla el audio)." />
                    <Button x:Name="SaveButton" Content="Guardar" Click="SaveButton_Click" />
                </StackPanel>
                <TextBlock x:Name="ReadyText" Foreground="#FF8A8F98" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="PrepareAllButton" Content="Preparar todas" Click="PrepareAllButton_Click" />
                <TextBlock x:Name="StatusText" Foreground="#FFA0A4AB" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Foreground="#FF8A8F98" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Las nueve primeras se envían con Ctrl+Alt+Numpad1…9 (con Bloq Num activado), incluso con Teams, Zoom o Meet en primer plano. Se envían por el micrófono virtual con la voz elegida en la ventana principal; si cambias de voz o activas «Mi voz», hay que volver a preparar." />
        </StackPanel>
    </Grid>
</Window>
